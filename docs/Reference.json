{
  "openapi": "3.0.3",
  "info": {
    "title": "WebInfo",
    "description": "HTTP API implemented by WebInfoPlugin for Spigot and Sponge. Dangerous administrative operations are not protected by built-in authentication.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Default port; configurable through web.port"
    }
  ],
  "tags": [
    {
      "name": "Common"
    },
    {
      "name": "Players"
    },
    {
      "name": "Worlds"
    },
    {
      "name": "Chat"
    },
    {
      "name": "Entity"
    },
    {
      "name": "Mods"
    },
    {
      "name": "DiscordSRV"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Common"
        ],
        "description": "Returns basic server information.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            }
          }
        }
      }
    },
    "/endpoints/": {
      "get": {
        "tags": [
          "Common"
        ],
        "description": "Returns the registered JRWeb routes.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "GET /",
                    "GET /endpoints/"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/shutdown": {
      "post": {
        "tags": [
          "Common"
        ],
        "description": "Stops the Minecraft server.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/mod/list": {
      "get": {
        "tags": [
          "Mods"
        ],
        "description": "Returns the installed plugins or mods.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModList"
                }
              }
            }
          }
        }
      }
    },
    "/player/": {
      "get": {
        "tags": [
          "Players"
        ],
        "description": "Returns data for an online player. The response body is null when the player is not found.",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Player"
                    }
                  ],
                  "nullable": true
                }
              }
            }
          }
        }
      }
    },
    "/player/list": {
      "get": {
        "tags": [
          "Players"
        ],
        "description": "Returns the names and UUIDs of online players.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NameUUIDPair"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/player/ban": {
      "post": {
        "tags": [
          "Players"
        ],
        "description": "Bans a player by UUID.",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          },
          {
            "name": "reason",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/player/banip": {
      "post": {
        "tags": [
          "Players"
        ],
        "description": "Bans an IP address.",
        "parameters": [
          {
            "name": "ip",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "127.0.0.1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/player/kick": {
      "post": {
        "tags": [
          "Players"
        ],
        "description": "Kicks an online player.",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          },
          {
            "name": "reason",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/player/teleport": {
      "post": {
        "tags": [
          "Players"
        ],
        "description": "Teleports an online player. When world is omitted, the player's current world is used.",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Location"
            },
            "description": "A Location object decoded from the query parameter by JRWeb/Gson."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/world/list": {
      "get": {
        "tags": [
          "Worlds"
        ],
        "description": "Returns complete data for the loaded worlds.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorldList"
                }
              }
            }
          }
        }
      }
    },
    "/world/unload": {
      "post": {
        "tags": [
          "Worlds"
        ],
        "description": "Unloads a world; save defaults to true.",
        "parameters": [
          {
            "name": "world",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "world"
            }
          },
          {
            "name": "save",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/chat/send": {
      "post": {
        "tags": [
          "Chat"
        ],
        "description": "Sends a message to a specific player. The current route does not support broadcasting.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatSendRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "400": {
            "description": "The body is not JSON or a required field is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/entity/spawn": {
      "post": {
        "tags": [
          "Entity"
        ],
        "description": "Spawns an entity and returns its UUID. Supported by Spigot; Sponge reports an unsupported operation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntitySpawnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
                }
              }
            }
          },
          "400": {
            "description": "The body is not JSON or a required field is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/plugin/discordsrv/": {
      "get": {
        "tags": [
          "DiscordSRV"
        ],
        "description": "Returns the channels and main Discord guild name. This route exists only when DiscordSRV is available.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscordInfo"
                }
              }
            }
          }
        }
      }
    },
    "/plugin/discordsrv/links": {
      "get": {
        "tags": [
          "DiscordSRV"
        ],
        "description": "Returns all Discord ID to player UUID links.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscordLinks"
                }
              }
            }
          }
        }
      }
    },
    "/plugin/discordsrv/links/generatecode": {
      "get": {
        "tags": [
          "DiscordSRV"
        ],
        "description": "Generates an account-linking code for a player.",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscordLinkCode"
                }
              }
            }
          }
        }
      }
    },
    "/plugin/discordsrv/links/getdiscordid": {
      "get": {
        "tags": [
          "DiscordSRV"
        ],
        "description": "Returns a Discord ID by player UUID.",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscordLink"
                }
              }
            }
          }
        }
      }
    },
    "/plugin/discordsrv/links/getplayeruuid": {
      "get": {
        "tags": [
          "DiscordSRV"
        ],
        "description": "Returns a player UUID by Discord ID.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "334625268159217665"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscordLink"
                }
              }
            }
          }
        }
      }
    },
    "/plugin/discordsrv/links/link": {
      "get": {
        "tags": [
          "DiscordSRV"
        ],
        "description": "Links a Discord ID to a player UUID. The implementation uses GET despite changing state.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "334625268159217665"
            }
          },
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscordLink"
                }
              }
            }
          }
        }
      }
    },
    "/plugin/discordsrv/links/unlink": {
      "get": {
        "tags": [
          "DiscordSRV"
        ],
        "description": "Removes an account link by player UUID. The implementation uses GET despite changing state.",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscordLink"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ServerInfo": {
        "type": "object",
        "required": [
          "mine_version",
          "players",
          "is_client",
          "platform",
          "tps"
        ],
        "properties": {
          "mine_version": {
            "type": "string",
            "example": "git-Spigot-79a30d7-acbc348 (MC: 1.16.5)"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "PlayerOne"
            ]
          },
          "is_client": {
            "type": "boolean",
            "example": false
          },
          "platform": {
            "type": "string",
            "enum": [
              "spigot",
              "sponge"
            ]
          },
          "tps": {
            "type": "number",
            "format": "double",
            "example": 20
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "x",
          "y",
          "z"
        ],
        "properties": {
          "x": {
            "type": "number",
            "format": "double",
            "example": 0
          },
          "y": {
            "type": "number",
            "format": "double",
            "example": 100
          },
          "z": {
            "type": "number",
            "format": "double",
            "example": 0
          },
          "world": {
            "type": "string",
            "example": "world"
          }
        }
      },
      "Vec2d": {
        "type": "object",
        "required": [
          "x",
          "z"
        ],
        "properties": {
          "x": {
            "type": "number",
            "format": "double"
          },
          "z": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "WorldBorder": {
        "type": "object",
        "required": [
          "size",
          "center",
          "damageBuffer",
          "damageAmount",
          "warningTime",
          "warningDistance"
        ],
        "properties": {
          "size": {
            "type": "number",
            "format": "double"
          },
          "center": {
            "$ref": "#/components/schemas/Vec2d"
          },
          "damageBuffer": {
            "type": "number",
            "format": "double"
          },
          "damageAmount": {
            "type": "number",
            "format": "double"
          },
          "warningTime": {
            "type": "integer",
            "format": "int64"
          },
          "warningDistance": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "World": {
        "type": "object",
        "required": [
          "name",
          "entities",
          "players",
          "uuid",
          "spawnLocation",
          "time",
          "fullTime",
          "storm",
          "weatherDuration",
          "thundering",
          "thunderDuration",
          "environment",
          "seed",
          "pvp",
          "maxHeight",
          "seaLevel",
          "keepSpawnInMemory",
          "difficulty",
          "worldType",
          "gameRules",
          "worldBorder"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          },
          "players": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uuid": {
            "type": "string",
            "format": "uuid",
            "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
          },
          "spawnLocation": {
            "$ref": "#/components/schemas/Location"
          },
          "time": {
            "type": "integer",
            "format": "int64"
          },
          "fullTime": {
            "type": "integer",
            "format": "int64"
          },
          "storm": {
            "type": "boolean"
          },
          "weatherDuration": {
            "type": "integer",
            "format": "int64"
          },
          "thundering": {
            "type": "boolean"
          },
          "thunderDuration": {
            "type": "integer",
            "format": "int64"
          },
          "environment": {
            "type": "string"
          },
          "seed": {
            "type": "integer",
            "format": "int64"
          },
          "pvp": {
            "type": "boolean"
          },
          "maxHeight": {
            "type": "integer",
            "format": "int32"
          },
          "seaLevel": {
            "type": "integer",
            "format": "int32"
          },
          "keepSpawnInMemory": {
            "type": "boolean"
          },
          "difficulty": {
            "type": "string"
          },
          "worldType": {
            "type": "string"
          },
          "gameRules": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "worldBorder": {
            "$ref": "#/components/schemas/WorldBorder"
          }
        }
      },
      "WorldList": {
        "type": "object",
        "required": [
          "count",
          "worlds"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "worlds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/World"
            }
          }
        }
      },
      "Player": {
        "type": "object",
        "required": [
          "name",
          "displayName",
          "location",
          "address",
          "sneaking",
          "sprinting",
          "playerTime",
          "exp",
          "level",
          "totalExperience",
          "saturation",
          "foodLevel",
          "flying",
          "flySpeed",
          "walkSpeed",
          "uuid",
          "firstPlayed",
          "lastPlayed",
          "playedBefore",
          "op"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "address": {
            "type": "string"
          },
          "sneaking": {
            "type": "boolean"
          },
          "sprinting": {
            "type": "boolean"
          },
          "playerTime": {
            "type": "integer",
            "format": "int64"
          },
          "exp": {
            "type": "number",
            "format": "float"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "totalExperience": {
            "type": "integer",
            "format": "int32"
          },
          "saturation": {
            "type": "number",
            "format": "float"
          },
          "foodLevel": {
            "type": "integer",
            "format": "int32"
          },
        "bedSpawnLocation": {
          "allOf": [
            {
              "$ref": "#/components/schemas/Location"
            }
          ],
          "nullable": true
        },
          "flying": {
            "type": "boolean"
          },
          "flySpeed": {
            "type": "number",
            "format": "float"
          },
          "walkSpeed": {
            "type": "number",
            "format": "float"
          },
          "uuid": {
            "type": "string",
            "format": "uuid",
            "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
          },
          "firstPlayed": {
            "type": "integer",
            "format": "int64"
          },
          "lastPlayed": {
            "type": "integer",
            "format": "int64"
          },
          "playedBefore": {
            "type": "boolean"
          },
          "op": {
            "type": "boolean"
          }
        }
      },
      "ActionResult": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "comment": {
            "type": "string"
          }
        }
      },
      "Mod": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ModList": {
        "type": "object",
        "required": [
          "count",
          "mods"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "mods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mod"
            }
          }
        }
      },
      "NameUUIDPair": {
        "type": "object",
        "required": [
          "name",
          "uuid"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "format": "uuid",
            "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
          }
        }
      },
      "ChatSendRequest": {
        "type": "object",
      "required": [
          "to",
          "message"
        ],
        "properties": {
          "to": {
            "type": "string",
            "format": "uuid",
            "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "EntitySpawnRequest": {
        "type": "object",
      "required": [
          "type",
          "location"
        ],
        "properties": {
          "type": {
            "type": "string",
            "example": "zombie"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "comment"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "type": "string"
          },
          "response": {
            "nullable": true
          }
        }
      },
      "DiscordInfo": {
        "type": "object",
        "required": [
          "channels",
          "guildName"
        ],
        "properties": {
          "channels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "global": "803933334664273320"
            }
          },
          "guildName": {
            "type": "string"
          }
        }
      },
      "DiscordLinkCode": {
        "type": "object",
        "required": [
          "code",
          "player"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "player": {
            "type": "string",
            "format": "uuid",
            "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
          }
        }
      },
      "DiscordLinks": {
        "type": "object",
        "required": [
          "users",
          "count"
        ],
        "properties": {
          "users": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "uuid",
              "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
            }
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DiscordLink": {
        "type": "object",
      "properties": {
          "discordId": {
            "type": "string",
            "nullable": true,
            "example": "334625268159217665"
          },
          "player": {
            "type": "string",
            "format": "uuid",
            "example": "5d3962eb-de89-4f91-9132-406b341fa51c"
          }
        }
      }
    }
  }
}
